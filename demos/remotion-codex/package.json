{
  "name": "iaeditestudo-remotion-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "studio": "remotion studio src/index.ts --no-open",
    "smoke:studio": "node scripts/studio-smoke.mjs",
    "render": "node scripts/render.mjs",
    "render:anime": "node scripts/render-anime.mjs",
    "render:study": "node scripts/render-study.mjs",
    "verify": "python3 scripts/verify.py"
  },
  "dependencies": {
    "@mojs/core": "1.7.1",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "animejs": "4.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
