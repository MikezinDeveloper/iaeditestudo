    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@theatre/core": "0.7.2",
    "animejs": "4.5.0",
    "d3": "7.9.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540",
    "three": "0.187.0",
    "two.js": "0.8.24"
  },
  "devDependencies": {
    "@react-three/test-renderer": "9.1.1",
    "@types/d3": "7.4.3",
